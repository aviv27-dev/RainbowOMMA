{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "pkill *": "deny",
      "killall *": "deny",
      "*osascript*quit*Google Chrome*": "deny",
      "*osascript*Google Chrome*quit*": "deny",
      "*Google Chrome*--remote-debugging-port*": "deny"
    }
  }
}
