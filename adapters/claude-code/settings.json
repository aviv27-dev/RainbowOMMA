{
  "env": {
    "RAINBOW_AGENT": "alpha"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|WebFetch|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/bin/rainbowomma-guard"
          }
        ]
      },
      {
        "matcher": "mcp__.*(cua|computer).*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/bin/rainbowomma-guard"
          }
        ]
      },
      {
        "matcher": "mcp__.*(chrome|devtools|playwright|browser).*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/bin/rainbowomma-guard"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/bin/rainbowomma-session-end"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(pkill *)",
      "Bash(killall *)"
    ]
  }
}
