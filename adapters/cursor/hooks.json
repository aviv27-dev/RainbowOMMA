{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "/Users/you/bin/rainbowomma-guard"
      }
    ],
    "preToolUse": [
      {
        "command": "/Users/you/bin/rainbowomma-guard",
        "matcher": "Write|Delete"
      }
    ],
    "beforeReadFile": [
      {
        "command": "/Users/you/bin/rainbowomma-guard"
      }
    ]
  }
}
