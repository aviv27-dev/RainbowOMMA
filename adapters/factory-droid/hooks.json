{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Execute|Read|Edit|Create|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/bin/rainbowomma-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/bin/rainbowomma-session-end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
