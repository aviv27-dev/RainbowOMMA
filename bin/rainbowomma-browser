#!/bin/bash
DIR="$(cd "$(dirname "$0")" && pwd)"
for PY in /opt/homebrew/bin/python3 /usr/bin/python3 /usr/local/bin/python3; do
  [ "$PY" = /usr/bin/python3 ] && [ "$(uname -s)" = Darwin ] && ! xcode-select -p >/dev/null 2>&1 && continue   # macOS's install-the-tools stub
  if [ -x "$PY" ] && "$PY" -I -V >/dev/null 2>&1; then exec "$PY" -I "$DIR/rainbowomma-browser.py" "$@"; fi
done
echo "rainbowomma-browser: no working python3 found — not opening anything" >&2
exit 0   # never a failure: webbrowser.open would fall back to the human's browser
