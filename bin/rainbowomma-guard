#!/bin/bash
# rainbowomma-guard — the pre-tool hook every agent adapter points to (see docs/AGENTS.md).
DIR="$(cd "$(dirname "$0")" && pwd)"
for PY in /opt/homebrew/bin/python3 /usr/bin/python3 /usr/local/bin/python3; do
  if [ -x "$PY" ] && "$PY" -I -V >/dev/null 2>&1; then exec "$PY" -I "$DIR/rainbowomma-guard.py" "$@"; fi
done
echo "rainbowomma-guard: no working python3 found — nothing checked" >&2
exit 0
